# POS frontend production environment for pos.hiddenoasis.app.
# Copy to /etc/hiddenoasis/pos-frontend.env and use the same values when running npm run build.

NODE_ENV=production
PORT=3200
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_STAFF_PAYROLL_APP_URL=https://staff.hiddenoasis.app
NEXT_PUBLIC_OPERATIONS_APP_URL=https://operations.hiddenoasis.app
NEXT_PUBLIC_ACCOUNTING_APP_URL=https://hiddenoasis.app
