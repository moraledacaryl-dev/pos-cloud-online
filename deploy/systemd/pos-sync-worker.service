[Unit]
Description=Hidden Oasis POS Accounting Sync Worker
After=network.target postgresql.service redis-server.service pos-backend.service
Requires=postgresql.service redis-server.service pos-backend.service

[Service]
Type=simple
User=hiddenoasis
Group=hiddenoasis
WorkingDirectory=/opt/pos-cloud-online/backend
EnvironmentFile=/etc/hiddenoasis/pos-backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pos-cloud-online/backend/.venv/bin/python -m app.workers.sync_worker
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
TasksMax=256
LimitNOFILE=32768
MemoryMax=768M

[Install]
WantedBy=multi-user.target
