[Unit]
Description=Hidden Oasis POS Frontend
After=network.target hiddenoasis-pos-backend.service

[Service]
Type=simple
User=hiddenoasis
Group=hiddenoasis
WorkingDirectory=/opt/pos-cloud-online/frontend
EnvironmentFile=/etc/hiddenoasis/pos-frontend.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
