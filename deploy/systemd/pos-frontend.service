[Unit]
Description=Hidden Oasis POS Frontend
After=network.target pos-backend.service
Requires=pos-backend.service

[Service]
Type=simple
User=hiddenoasis
Group=hiddenoasis
WorkingDirectory=/opt/pos-cloud-online/frontend
Environment=NODE_ENV=production
EnvironmentFile=/etc/hiddenoasis/pos-frontend.env
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3100
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
TasksMax=512
LimitNOFILE=65536
MemoryMax=1G
ReadWritePaths=/opt/pos-cloud-online/frontend/.next/cache

[Install]
WantedBy=multi-user.target
