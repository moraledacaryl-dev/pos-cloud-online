[Unit]
Description=Hidden Oasis POS Accounting Sync Worker
After=network.target postgresql.service hiddenoasis-pos-backend.service
Requires=postgresql.service

[Service]
Type=simple
User=hiddenoasis
Group=hiddenoasis
WorkingDirectory=/opt/pos-cloud-online/backend
EnvironmentFile=/etc/hiddenoasis/pos-backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pos-cloud-online/backend/.venv/bin/python -m app.workers.sync_worker
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
