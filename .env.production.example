# POS backend production environment for pos.hiddenoasis.app.
# Copy to /etc/hiddenoasis/pos-backend.env on the server.
# Generate real secrets on the server; do not reuse the sample values below.

APP_NAME="POS Cloud"
ENVIRONMENT=production
API_PREFIX=/api
PORT=8200

DATABASE_URL=postgresql+psycopg://hiddenoasis_pos_app:CHANGE_ME_POS_DB_PASSWORD@127.0.0.1:5432/hiddenoasis_pos_live
POSTGRES_DB=hiddenoasis_pos_live
POSTGRES_USER=hiddenoasis_pos_app
POSTGRES_PASSWORD=CHANGE_ME_POS_DB_PASSWORD

SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOW_DEFAULT_ADMIN_BOOTSTRAP=false

CORS_ORIGINS=https://pos.hiddenoasis.app
INTEGRATION_API_KEY=CHANGE_ME_SHARED_CROSS_APP_INTEGRATION_API_KEY
ACCOUNTING_API_BASE=https://accounting.hiddenoasis.app/api
ACCOUNTING_INTEGRATION_SECRET=CHANGE_ME_SHARED_POS_ACCOUNTING_INTEGRATION_SECRET
ACCOUNTING_INTEGRATION_TOKEN_PATH=/auth/integration/token

HTTP_TIMEOUT_SECONDS=20
HEALTH_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_PREFIX=pos-cloud:ratelimit
REDIS_URL=redis://127.0.0.1:6379/0
STARTUP_REQUIRE_MIGRATIONS=true
SYNC_WORKER_POLL_SECONDS=30
SYNC_WORKER_BATCH_SIZE=25
SYNC_WORKER_STALE_SECONDS=120
TRUSTED_PROXY_DEPTH=1
TRUST_PROXY_HEADERS=true
